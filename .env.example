# Meta Graph API access tokens (server-side only)
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_2=
META_ACCESS_TOKEN_3=

# Vercel Postgres connection string — persistent cache for Meta insights
# (Vercel Dashboard → project → Storage → Create Database → Postgres)
POSTGRES_URL=

# Internal access protection (server-side only)
# Password: at least 12 characters
INTERNAL_DASHBOARD_PASSWORD=
# Secret: at least 32 characters; generate with: openssl rand -base64 48
INTERNAL_DASHBOARD_SECRET=

# OpenAI vision API — used by /creative-review to auto-analyze uploaded creatives
# against data/creative-checklist.json (server-side only)
OPENAI_API_KEY=
# Optional: defaults to gpt-4o
OPENAI_MODEL=

# External read-only API (GET /api/external/ads-spend) — for other internal
# systems (e.g. Qlass) to pull total ad spend by date range. Separate from
# INTERNAL_DASHBOARD_SECRET so it can be revoked without logging the team out.
# At least 32 characters; generate with: openssl rand -base64 48
EXTERNAL_API_KEY=
